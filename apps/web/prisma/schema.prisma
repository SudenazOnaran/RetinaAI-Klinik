generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id               String                  @id @default(cuid())
  name             String
  email            String                  @unique
  password         String
  role             DoctorRole              @default(DOCTOR)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  surname          String
  specialty        String
  hospital         String
  approvalStatus   ApprovalStatus          @default(APPROVED)
  calendarEvents   CalendarEvent[]
  credentialPolicy DoctorCredentialPolicy?
  settings         DoctorSettings?
  patients         Patient[]
}

model Patient {
  id            String     @id @default(cuid())
  doctorId      String
  fullName      String
  tcNo          String
  age           Int
  risk          String     @default("Yok")
  createdAt     DateTime   @default(now())
  diabetesYears Int?
  gender        String?
  hba1c         Float?
  analyses      Analysis[]
  doctor        Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                              String                @id @default(cuid())
  patientId                       String
  aiResult                        String
  confidence                      Float
  heatmapUrl                      String?
  originalImage                   String?
  /// Geriye dönük: manual_report_v2 JSON; yeni kayıtlarda structured alanlar + bu alan birlikte dolar
  doctorNote                      String?
  isCorrect                       Boolean?
  actualResult                    String?
  createdAt                       DateTime              @default(now())
  aiOdriLabels                    String?
  aiOdriConfidences               String?
  ilaclar                         String?               @db.VarChar(1500)
  drFeedback                      String?
  /// LLM /predict yapısal çıktısı (heatmap base64 hariç); veri seti export için
  aiInferenceJson                 Json?
  /// `src/lib/dataset/manifest-v1.schema.json` ile uyumlu export şema sürümü
  datasetSchemaVersion            String                @default("1")
  /// DR 0–4: tercihen klinik özeti (doktor geri bildirimi > AI snapshot > yok)
  drGradeInt                      Int?
  /// Doktorun yapısal düzeltmeleri (fundus, DME, clinicalDecision vb.); eğitimde altın/ince ayar
  doctorStructuredReview          Json?
  /// Doktorun serbest klinik gerekçe metni (LLM teacher’a ek veya yerine geçen hedef)
  physicianClinicalReasoning      String?
  /// HT, dislipidemi vb. yapılandırılmış komorbidite
  comorbidityJson                 Json?
  /// Rapor tarihi metni (örn. 24.04.2026 veya ISO)
  reportDateKey                   String?               @db.VarChar(32)
  /// Raporda gösterilen hekim adı
  reportDoctorDisplayName         String?               @db.VarChar(200)
  /// Rapor başlığı (örn. Göz Muayene Raporu)
  reportTitle                     String?               @db.VarChar(500)
  sectionAnamnesis                String?
  sectionClinicalAssessment       String?
  sectionDoctorNotes              String?
  sectionExamFindings             String?
  sectionLabResults               String?
  sectionTreatmentRecommendations String?
  /// Model belirsizliği 0–1 (yüksek = daha belirsiz); snapshot veya 1−DR güveni
  uncertaintyScore                Float?
  /// Kayıtlı FFA kaynak görüntüsü (URL)
  ffaImageUrl                     String?
  /// Kayıtlı maküler OCT kaynak görüntüsü (URL)
  octImageUrl                     String?
  /// Son analizde FFA için doktor geri bildirimi / düzeltme
  ffaDrFeedback                   String?
  /// Son analizde OCT için doktor geri bildirimi / düzeltme
  octDrFeedback                   String?
  /// Klinik metin raporu vs radyolojik (AI görüntü) kaydı; eski satırlarda null olabilir
  reportKind                      AnalysisReportKind?
  patient                         Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  trainingDatasetEntry            TrainingDatasetEntry?
  trainingDatasetEntryOct         TrainingDatasetEntryOct?
  trainingDatasetEntryFfa         TrainingDatasetEntryFfa?
}

/// Egitim satiri: goruntu URL, efektif DR, doktor notlari ozeti, `training_snapshot_v2` JSON, ML sutunlari.
/// Ayrintili yapı: `src/lib/dataset/training-snapshot-v2.ts`. Diger klinik alanlar: Analysis.
model TrainingDatasetEntry {
  id                           String   @id @default(cuid())
  analysisId                   String   @unique
  originalImageUrl             String
  /// Etkin DR etiketi: yalnizca doktor karari (0: saglikli, 1: mild, 2: moderate, 3: severe, 4: proliferatif)
  drFeedback                   Int
  updatedAt                    DateTime @updatedAt
  /// Doktor geri bildirimine gore fundus NVD varligi 0/1
  fundusNvd                    Int?
  /// Doktor geri bildirimine gore fundus NVE varligi 0/1
  fundusNve                    Int?
  /// Rapor: doktor notlari + klinik/muayene/tedavi metinleri birlesik (parse + egitim metni)
  doctorNotesText              String?
  /// Analysis.doctorNote ile ayni: manual_report_v2 JSON (rapor meta + sections + aiSummary)
  doctorNote                   String?
  analysis                     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

/// OCT egitim satiri: kaydedilen OCT goruntu + doktorun nihai karari.
model TrainingDatasetEntryOct {
  id                  String   @id @default(cuid())
  analysisId          String   @unique
  octImageUrl         String
  /// Egitim etiketi: yalnizca doktor karari (ham secim kaydi)
  octDoctorDecision   String
  /// Doktor seciminden turetilen 0/1 hedefler
  octHealthy          Int?
  octDme              Int?
  octAmd              Int?
  octMacularHole      Int?
  octErmVmt           Int?
  updatedAt           DateTime @updatedAt
  analysis            Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

/// FFA egitim satiri: kaydedilen FFA goruntu + doktorun nihai karari.
model TrainingDatasetEntryFfa {
  id                  String   @id @default(cuid())
  analysisId          String   @unique
  ffaImageUrl         String
  /// Egitim etiketi: yalnizca doktor karari (zorunlu)
  ffaDoctorDecision   String
  /// Doktor seciminden turetilen 0/1 hedefler
  ffaHealthy          Int?
  ffaDr               Int?
  ffaRvo              Int?
  ffaAmdCnv           Int?
  ffaCsr              Int?
  ffaUveitis          Int?
  /// DR ile iliskili neovaskularizasyon hedefleri (doktor secimi)
  ffaNvd              Int?
  ffaNve              Int?
  /// DR secildiyse doktor evresi 0..4, degilse null
  ffaDrStage          Int?
  updatedAt           DateTime @updatedAt
  analysis            Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DoctorSettings {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  doctorId  String
  dateKey   String
  time      String
  title     String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dateKey])
}

model AuditLog {
  id          String   @id
  doctorId    String
  role        String
  action      String
  entityType  String
  entityId    String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model IntegrationEvent {
  id              String   @id
  doctorId        String
  patientId       String
  target          String
  status          String
  httpStatus      Int?
  errorMessage    String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([patientId])
}

model DoctorCredentialPolicy {
  doctorId                   String    @id
  mustResetPassword          Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime?
  updatedAt                  DateTime  @updatedAt
  doctor                     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  key             String    @id
  failedCount     Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([lockedUntil])
}

model AiRequestQueue {
  id        String   @id
  doctorId  String
  status    String
  endpoint  String
  payload   Json
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model KvkkConsent {
  id             String    @id
  doctorId       String
  patientId      String
  consentGiven   Boolean   @default(false)
  consentVersion String    @default("v1")
  consentAt      DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([doctorId, patientId])
  @@index([doctorId, updatedAt(sort: Desc)])
}

model KvkkProcessingLog {
  id        String   @id
  doctorId  String
  patientId String?
  action    String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
}

model MonitoringAlert {
  id        String   @id
  doctorId  String?
  source    String
  severity  String
  title     String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([doctorId, createdAt(sort: Desc)])
}

model PilotMetricEvent {
  id            String   @id
  doctorId      String
  metricKey     String
  metricLabel   String
  direction     String
  baselineValue Float
  currentValue  Float
  unit          String
  sampleSize    Int      @default(0)
  periodStart   DateTime
  periodEnd     DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([doctorId, metricKey, createdAt(sort: Desc)])
}

model PilotMetricSnapshot {
  id            String   @id
  doctorId      String
  snapshotMonth String
  summaryJson   Json
  eventCount    Int      @default(0)
  generatedAt   DateTime @default(now())

  @@unique([doctorId, snapshotMonth])
  @@index([doctorId, generatedAt(sort: Desc)])
}

/// Tanıtım sitesi “Bize ulaşın / demo talep” formu (admin panelinde listelenir)
model LandingContactRequest {
  id        String   @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

enum DoctorRole {
  DOCTOR
  ASSISTANT
  MANAGER
  AUDITOR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnalysisReportKind {
  clinical_manual
  radiological_ai
}
