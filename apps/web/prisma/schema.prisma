generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DoctorRole {
  DOCTOR
  ASSISTANT
  MANAGER
  AUDITOR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Doctor {
  id             String            @id @default(cuid())
  name           String
  surname        String
  email          String            @unique
  password       String
  specialty      String
  hospital       String
  role           DoctorRole        @default(DOCTOR)
  approvalStatus ApprovalStatus    @default(APPROVED)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  patients         Patient[]
  settings         DoctorSettings?
  calendarEvents   CalendarEvent[]
  credentialPolicy DoctorCredentialPolicy?
}

model Patient {
  id            String     @id @default(cuid())
  doctorId      String
  fullName      String
  tcNo          String
  age           Int
  risk          String     @default("Yok")
  createdAt     DateTime   @default(now())
  diabetesYears Int?
  gender        String?
  hba1c         Float?
  analyses      Analysis[]
  doctor        Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                   String   @id @default(cuid())
  patientId            String
  aiResult             String
  confidence           Float
  heatmapUrl           String?
  originalImage        String?
  /// Geriye dönük: manual_report_v2 JSON; yeni kayıtlarda structured alanlar + bu alan birlikte dolar
  doctorNote           String?
  /// Rapor başlığı (örn. Göz Muayene Raporu)
  reportTitle          String?  @db.VarChar(500)
  /// Rapor tarihi metni (örn. 24.04.2026 veya ISO)
  reportDateKey        String?  @db.VarChar(32)
  /// Raporda gösterilen hekim adı
  reportDoctorDisplayName String? @db.VarChar(200)
  sectionAnamnesis         String? @db.Text
  sectionExamFindings      String? @db.Text
  sectionLabResults        String? @db.Text
  sectionClinicalAssessment String? @db.Text
  sectionTreatmentRecommendations String? @db.Text
  sectionDoctorNotes       String? @db.Text
  /// HT, dislipidemi vb. yapılandırılmış komorbidite
  comorbidityJson      Json?
  /// Model belirsizliği 0–1 (yüksek = daha belirsiz); snapshot veya 1−DR güveni
  uncertaintyScore     Float?
  isCorrect            Boolean?
  actualResult         String?
  createdAt            DateTime @default(now())
  aiOdriLabels         String?
  aiOdriConfidences    String?
  ilaclar              String?  @db.VarChar(1500)
  drFeedback           String?
  /// Doktorun yapısal düzeltmeleri (fundus, DME, clinicalDecision vb.); eğitimde altın/ince ayar
  doctorStructuredReview Json?
  /// Doktorun serbest klinik gerekçe metni (LLM teacher’a ek veya yerine geçen hedef)
  physicianClinicalReasoning String? @db.Text
  /// LLM /predict yapısal çıktısı (heatmap base64 hariç); veri seti export için
  aiInferenceJson      Json?
  /// DR 0–4: tercihen klinik özeti (doktor geri bildirimi > AI snapshot > yok)
  drGradeInt           Int?
  /// `src/lib/dataset/manifest-v1.schema.json` ile uyumlu export şema sürümü
  datasetSchemaVersion String   @default("1")
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  trainingDatasetEntry TrainingDatasetEntry?
}

/// Egitim satiri: goruntu URL, efektif DR, doktor notlari ozeti, `training_snapshot_v2` JSON, ML sutunlari.
/// Ayrintili yapı: `src/lib/dataset/training-snapshot-v2.ts`. Diger klinik alanlar: Analysis.
model TrainingDatasetEntry {
  id                    String   @id @default(cuid())
  analysisId            String   @unique
  originalImageUrl      String
  /// Etkin DR etiketi (TR depo formu): doktor duzeltmesi veya AI onayi ile ayni metin; egitimde null olmamali
  drFeedback            String?
  /// Rapor: doktor notlari + klinik/muayene/tedavi metinleri birlesik (parse + egitim metni)
  doctorNotesText       String?  @db.Text
  /// Analysis.doctorNote ile ayni: manual_report_v2 JSON (rapor meta + sections + aiSummary)
  doctorNote            String?  @db.Text
  /// `training_snapshot_v2`: from_image | from_teacher_text | provenance
  inferenceSnapshotJson Json?
  /// Doktor notları / klinik metin parse: sağlıklı→0, mild ile uyumlu→1, moderate→2, severe→3, PDR→4
  doctorNotesDerivedDrGradeInt Int?
  /// MA yükü: 0 yok, 1 az/sparse, 2 yaygın (fundus_assessment veya fundus_findings)
  microaneurysmCountLevel Int?
  /// Hemoraji kadran sayısı 0–4
  hemorrhageQuadrants   Int?
  /// Maküler sert eksüda / makula yakını eksüda 0/1
  hardExudateMacula     Int?
  cottonWoolSpots       Int?
  venousBeading         Int?
  irma                  Int?
  neovascularization    Int?
  /// DME şüphesi 0/1 (makula+eksüda kuralı, fundus_assessment, API DME)
  trainingDmeSuspected  Int?
  updatedAt             DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DoctorSettings {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  doctorId  String
  dateKey   String
  time      String
  title     String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dateKey])
}

model AuditLog {
  id          String   @id
  doctorId    String
  role        String
  action      String
  entityType  String
  entityId    String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model IntegrationEvent {
  id              String   @id
  doctorId        String
  patientId       String
  target          String
  status          String
  httpStatus      Int?
  errorMessage    String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([patientId])
}

model DoctorCredentialPolicy {
  doctorId                   String    @id
  mustResetPassword          Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime?
  updatedAt                  DateTime  @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  key             String   @id
  failedCount     Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
}

model AiRequestQueue {
  id        String   @id
  doctorId  String
  status    String
  endpoint  String
  payload   Json
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model KvkkConsent {
  id             String   @id
  doctorId       String
  patientId      String
  consentGiven   Boolean  @default(false)
  consentVersion String   @default("v1")
  consentAt      DateTime?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([doctorId, patientId])
  @@index([doctorId, updatedAt(sort: Desc)])
}

model KvkkProcessingLog {
  id        String   @id
  doctorId  String
  patientId String?
  action    String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
}

model MonitoringAlert {
  id        String   @id
  doctorId  String?
  source    String
  severity  String
  title     String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([doctorId, createdAt(sort: Desc)])
}

model PilotMetricEvent {
  id            String   @id
  doctorId      String
  metricKey     String
  metricLabel   String
  direction     String
  baselineValue Float
  currentValue  Float
  unit          String
  sampleSize    Int      @default(0)
  periodStart   DateTime
  periodEnd     DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([doctorId, metricKey, createdAt(sort: Desc)])
}

model PilotMetricSnapshot {
  id           String   @id
  doctorId     String
  snapshotMonth String
  summaryJson  Json
  eventCount   Int      @default(0)
  generatedAt  DateTime @default(now())

  @@unique([doctorId, snapshotMonth])
  @@index([doctorId, generatedAt(sort: Desc)])
}

/// Tanıtım sitesi “Bize ulaşın / demo talep” formu (admin panelinde listelenir)
model LandingContactRequest {
  id        String   @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  message   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
