# Core application
# Veritabanı adı (retina_db / retina_ai) PostgreSQL’de oluşturduğunuz DB ile aynı olmalı.
# Sorun yaşarsanız localhost yerine 127.0.0.1 deneyin (Windows IPv6).
DATABASE_URL="postgresql://postgres:12345@localhost:5432/retina_db"
# Next.js "/" adresi buraya yönlendirilir (tanıtım sitesi). Canlıda https://retina-ai.tech gibi tam URL.
MARKETING_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=change-me-session-secret
# NEXTAUTH_SECRET can be used as fallback if SESSION_SECRET is not set
NEXTAUTH_SECRET=

# Next.js build/runtime
NEXT_DIST_DIR=.next-dev
NODE_ENV=development

# AI gateway + AI service
# Gemini servisi (app_gemini.py): ornek http://localhost:5001/predict — klasik DR (app.py): 5000
# Her basarili analiz + rapor kaydi veri setini buyutur (Analysis, TrainingDatasetEntry); export: scripts/export-training-dataset-entries.js
AI_SERVICE_URL=http://localhost:5000/predict
# Makula OCT (app_gemini.py /predict-oct). Bos birakilirsa AI_SERVICE_URL tabaninda /predict yerine /predict-oct kullanilir (or. http://localhost:5001/predict-oct).
AI_OCT_SERVICE_URL=
# FFA yalnizca app_gemini.py'de (/predict-ffa). app.py (5000) bu yolu sunmaz → 404 alirsiniz.
# Ornek: AI_SERVICE_URL=http://127.0.0.1:5001/predict ise FFA otomatik http://127.0.0.1:5001/predict-ffa olur.
AI_FFA_SERVICE_URL=
AI_GATEWAY_SHARED_SECRET=change-me-ai-gateway-secret
AI_REQUEST_TIMEOUT_MS=20000
AI_REQUEST_RETRY_COUNT=2
AI_ALLOW_HTTP_IN_PROD=0

# AI Flask service CORS/rate-limit
AI_CORS_ALLOWED_ORIGINS=http://localhost:9002,http://127.0.0.1:9002
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_REDIS_URL=
AI_RATE_LIMIT_REDIS_PREFIX=ai:ratelimit
FLASK_DEBUG=0

# Login hardening
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TEMP_PASSWORD_TTL_HOURS=24

# Profile verification delivery (optional; required in production for real send)
PROFILE_VERIFY_EMAIL_WEBHOOK_URL=
PROFILE_VERIFY_SMS_WEBHOOK_URL=
PROFILE_VERIFY_WEBHOOK_TOKEN=

# Monitoring and cron protection
INTERNAL_HEALTH_TOKEN=change-me-health-token
PILOT_METRICS_CRON_SECRET=change-me-cron-secret

# Deployment/SLA profile
DEPLOYMENT_PROFILE=ON_PREM
SLA_UPTIME_TARGET_PERCENT=99.5
SLA_P1_RESPONSE_MINUTES=15
SLA_P1_RESOLUTION_HOURS=4
SLA_P2_RESPONSE_HOURS=4
SLA_BACKUP_FREQUENCY_HOURS=24
SLA_RPO_HOURS=24
SLA_RTO_HOURS=8

# Clinical integration endpoints (optional)
FHIR_BASE_URL=
FHIR_EXPORT_URL=
FHIR_AUTH_TOKEN=
HBYS_BASE_URL=
HBYS_EXPORT_URL=
HBYS_API_KEY=

# Structured logging / central ingestion (optional)
LOG_LEVEL=info
LOG_INGEST_URL=
LOG_INGEST_TOKEN=
MONITORING_P95_LATENCY_MS=1200
MONITORING_ERROR_RATE_PERCENT=5
MONITORING_QUEUE_DEPTH_THRESHOLD=25

# Playwright (optional)
E2E_BASE_URL=http://127.0.0.1:9002
PW_SKIP_WEBSERVER=0

# E-posta (admin onayında doktora giriş linki; SMTP eksikse gönderim atlanır, onay yine kaydedilir)
# Örnek gönderen: retinai.klinik@gmail.com — Gmail için uygulama şifresi kullanın.
ADMIN_REGISTRATION_NOTIFY_EMAIL=
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Boşsa From = "Retina AI <SMTP_USER>"
SMTP_FROM=

# Veri seti export (scripts/export-dataset-manifest.js --anonymize)
# Ayni hasta anahtarinin tekrarlanabilir hash'i icin sabit tuz; repoya gercek deger koymayin.
# EXPORT_PATIENT_SALT=

