# Depoda tutarlı satır sonları (LF); Windows’ta `git add` LF/CRLF uyarılarını azaltır.
* text=auto eol=lf

# Windows’a özgü betikler CRLF kalsın
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
