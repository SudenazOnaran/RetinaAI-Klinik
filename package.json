{
  "name": "retina-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Retina AI web + AI service monorepo",
  "scripts": {
    "dev": "npm run web:dev",
    "web:install": "npm --prefix apps/web install",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "npm --prefix apps/web run start",
    "web:lint": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web run test",
    "ai:run": "python services/ai/app.py",
    "mobile:get": "flutter --project-directory=apps/mobile pub get",
    "mobile:dev": "flutter --project-directory=apps/mobile run",
    "mobile:build:apk": "flutter --project-directory=apps/mobile build apk --release",
    "mobile:build:ios": "flutter --project-directory=apps/mobile build ios --release",
    "mobile:test": "flutter --project-directory=apps/mobile test"
  }
}
