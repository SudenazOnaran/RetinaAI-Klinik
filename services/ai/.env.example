# Sablon: gercek degerler icin bu dosyayi KOPYALAYIP .env.local yapin veya asagidakileri .env.local'de tanimlayin.
# UYARI: Gercek API anahtarini repoya (.env.example) commit etmeyin.
#
# ONCELIK (su an): Uretim analizi = Gemini (app_gemini.py). Veri seti, web'de rapor
# kaydedildikce Analysis + TrainingDatasetEntry ile buyur; yerel .pt inference ikinci plandadir.
# USE_LOCAL_MULTITASK_FIRST acmayin; model hazir olunca acilir.

AI_GATEWAY_SHARED_SECRET=change-me-ai-shared-secret
AI_CORS_ALLOWED_ORIGINS=http://localhost:9002,http://127.0.0.1:9002
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_REDIS_URL=
AI_RATE_LIMIT_REDIS_PREFIX=ai:ratelimit
AI_HOST=0.0.0.0
AI_PORT=5000
FLASK_DEBUG=0

# app_gemini.py — Google AI Studio API anahtari (kota dolunca sirayla: GEMINI_API_KEY_2 veya GEMINI_API_KEYS=a,b)
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEYS=
# Ornekler: gemini-2.5-flash (varsayilan), gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_IMAGE_SIDE=224
# Veri seti / export: prompt degisince artirin (inference.promptVersion)
GEMINI_PROMPT_VERSION=1
AI_GEMINI_PORT=5001
# Grad-CAM++: bos birak veya 1 = acik; 0 = kapali. Bos + model.pth/model.pt varsa acik (varsayilan).
# GEMINI_DR_HEATMAP=
# app.py / Gemini yedek DenseNet: oncelik models/model.pth, yoksa models/model.pt. Isterseniz tam yol:
# DR_DENSENET_WEIGHTS=C:/path/to/model.pt
# CPU'da PyTorch conv2d "could not create a primitive" hatasi: mkldnn kapali (varsayilan). Zorunlu degil:
# TORCH_MKLDNN=1

# --- Ileride: egitilmis yerel multitask (.pt) ile /predict (Gemini ile ayni JSON sekli) ---
# Model yokken KAPALI birakin. Acildiginda GEMINI_API_KEY istege bagli (yedek icin).
# USE_LOCAL_MULTITASK_FIRST=0
# LOCAL_MULTITASK_WEIGHTS=training_out/multitask_mvp.pt
