# VPS: /etc/systemd/system/retinai-gemini-ai.service
# Yolları sunucudaki gerçek dizinle değiştirin, sonra:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now retinai-gemini-ai
#   curl -s http://127.0.0.1:5001/health

[Unit]
Description=Retina AI Gemini Flask (app_gemini.py)
After=network.target

[Service]
Type=simple
# Manuel testi deploy ile yaptiysaniz ( .env.local sahibi deploy ): User/Group=deploy kullanin.
# Nginx+www-data ile ayni kullanici gerekiyorsa .env.local okunabilirligi: chmod 640, grup www-data.
User=deploy
Group=deploy
WorkingDirectory=/opt/apps/retina_ai/services/ai
EnvironmentFile=-/opt/apps/retina_ai/services/ai/.env.local
ExecStart=/opt/apps/retina_ai/services/ai/.venv/bin/python app_gemini.py
Restart=on-failure
RestartSec=8
# OCT/FFA Gemini cevabi uzun sürebilir
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
