generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DoctorRole {
  DOCTOR
  ASSISTANT
  MANAGER
  AUDITOR
}

model Doctor {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String
  role           DoctorRole        @default(DOCTOR)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  patients       Patient[]
  settings       DoctorSettings?
  calendarEvents CalendarEvent[]
}

model Patient {
  id            String     @id @default(cuid())
  doctorId      String
  fullName      String
  tcNo          String
  age           Int
  risk          String     @default("Yok")
  createdAt     DateTime   @default(now())
  diabetesYears Int?
  gender        String?
  hba1c         Float?
  analyses      Analysis[]
  doctor        Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                String   @id @default(cuid())
  patientId         String
  aiResult          String
  confidence        Float
  heatmapUrl        String?
  originalImage     String?
  doctorNote        String?
  isCorrect         Boolean?
  actualResult      String?
  createdAt         DateTime @default(now())
  aiOdriLabels      String?
  aiOdriConfidences String?
  ilaclar           String?  @db.VarChar(200)
  drFeedback        String?
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DoctorSettings {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  doctorId  String
  dateKey   String
  time      String
  title     String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dateKey])
}

model AuditLog {
  id          String   @id
  doctorId    String
  role        String
  action      String
  entityType  String
  entityId    String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model IntegrationEvent {
  id              String   @id
  doctorId        String
  patientId       String
  target          String
  status          String
  httpStatus      Int?
  errorMessage    String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
  @@index([patientId])
}

model LoginAttempt {
  key             String   @id
  failedCount     Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
}

model AiRequestQueue {
  id        String   @id
  doctorId  String
  status    String
  endpoint  String
  payload   Json
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model KvkkConsent {
  id             String   @id
  doctorId       String
  patientId      String
  consentGiven   Boolean  @default(false)
  consentVersion String   @default("v1")
  consentAt      DateTime?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([doctorId, patientId])
  @@index([doctorId, updatedAt(sort: Desc)])
}

model KvkkProcessingLog {
  id        String   @id
  doctorId  String
  patientId String?
  action    String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt(sort: Desc)])
}

model MonitoringAlert {
  id        String   @id
  doctorId  String?
  source    String
  severity  String
  title     String
  detail    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([doctorId, createdAt(sort: Desc)])
}

model PilotMetricEvent {
  id            String   @id
  doctorId      String
  metricKey     String
  metricLabel   String
  direction     String
  baselineValue Float
  currentValue  Float
  unit          String
  sampleSize    Int      @default(0)
  periodStart   DateTime
  periodEnd     DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([doctorId, metricKey, createdAt(sort: Desc)])
}

model PilotMetricSnapshot {
  id           String   @id
  doctorId     String
  snapshotMonth String
  summaryJson  Json
  eventCount   Int      @default(0)
  generatedAt  DateTime @default(now())

  @@unique([doctorId, snapshotMonth])
  @@index([doctorId, generatedAt(sort: Desc)])
}
