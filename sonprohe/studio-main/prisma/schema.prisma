generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DoctorRole {
  DOCTOR
  ASSISTANT
  MANAGER
  AUDITOR
}

model Doctor {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String
  role           DoctorRole        @default(DOCTOR)
  createdAt      DateTime          @default(now())
  patients       Patient[]
  settings       DoctorSettings?
  calendarEvents CalendarEvent[]
}

model Patient {
  id            String     @id @default(cuid())
  doctorId      String
  fullName      String
  tcNo          String
  age           Int
  risk          String     @default("Yok")
  createdAt     DateTime   @default(now())
  diabetesYears Int?
  gender        String?
  hba1c         Float?
  analyses      Analysis[]
  doctor        Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                String   @id @default(cuid())
  patientId         String
  aiResult          String
  confidence        Float
  heatmapUrl        String?
  originalImage     String?
  doctorNote        String?
  isCorrect         Boolean?
  actualResult      String?
  createdAt         DateTime @default(now())
  aiOdriLabels      String?
  aiOdriConfidences String?
  ilaclar           String?  @db.VarChar(200)
  drFeedback        String?
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DoctorSettings {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  doctorId  String
  dateKey   String
  time      String
  title     String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dateKey])
}
