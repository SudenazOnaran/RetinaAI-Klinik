{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "env:check": "node scripts/check-required-env.mjs",
    "env:check:release": "cross-env ENV_CHECK_MODE=release node scripts/check-required-env.mjs",
    "clean:next-artifacts": "node scripts/clean-next-artifacts.mjs",
    "clean:build": "node -e \"require('fs').rmSync('.next-build',{recursive:true,force:true})\"",
    "build": "npm run clean:next-artifacts && npm run clean:build && cross-env NODE_ENV=production NEXT_DIST_DIR=.next-build next build",
    "start": "cross-env NEXT_DIST_DIR=.next-build next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "release:check": "npm run clean:next-artifacts && npm run env:check:release && npm run ci && npm run test:e2e && npm run build",
    "fix:analysis-feedback": "node scripts/fix-analysis-feedback.js"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.30.1",
    "@genkit-ai/next": "^1.30.1",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "genkit": "^1.30.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.475.0",
    "next": "^15.5.14",
    "patch-package": "^8.0.0",
    "prisma": "^6.19.1",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "genkit-cli": "^1.20.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "effect": "^3.20.0",
    "fast-xml-parser": "^5.5.7"
  }
}
